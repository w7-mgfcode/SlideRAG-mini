# SlideRAG Mini settings schema. Copy to a private .env OUTSIDE the repository
# checkout (chmod 600) and pass it to the container at runtime. Never commit real
# values. The application does not load .env files itself; it reads the process
# environment once at startup (app/config.py).

# Required for upload/ask. Left empty on purpose: an unedited copy keeps
# /health degraded (HTTP 503) instead of sending a placeholder to the API.
OPENAI_API_KEY=

# Chat model for schema-constrained answers (default: gpt-4.1-mini).
LLM_MODEL=gpt-4.1-mini

# Embedding model (default: text-embedding-3-small). Changing it changes the
# index configuration; existing data is then refused, not migrated.
EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible endpoints. Empty resolves to the explicit default
# https://api.openai.com/v1; ambient SDK variables (OPENAI_BASE_URL,
# OPENAI_API_BASE, LANGSMITH_GATEWAY) are ignored. Must be https with a valid ASCII
# host (IDNs in punycode) and port; must not embed credentials, a query string or a
# fragment. Values are canonicalised (lowercase host, no trailing slash, no :443;
# path case kept). EMBEDDING_BASE_URL is part of the index configuration.
LLM_BASE_URL=
EMBEDDING_BASE_URL=

# Data root for uploads/, chroma/ and manifest.json. /data in the container
# (EBS bind mount on EC2); an explicit local path in development.
DATA_DIR=/data
